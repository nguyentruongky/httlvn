# Supabase Transaction Pooler (Port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) for Drizzle migrations & seeding (bun run db:push && bun run db:seed)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Production destination for bun run db:seed-prod (set the real connection URL locally)
PRODUCTION_DATABASE_URL=""

# Admin auth (JWT secret - change this in production!)
ADMIN_JWT_SECRET="change-me-in-production"

# Default admin account (seeded on first run)
ADMIN_EMAIL="admin@htkv.vn"
ADMIN_PASSWORD="admin123"
